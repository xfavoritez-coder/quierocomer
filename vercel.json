{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "crons": [
{
      "path": "/api/cron/cleanup?key=__SEED_SECRET__",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/toteat-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/nurturing",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/warm-feed",
      "schedule": "*/4 * * * *"
    }
  ]
}
