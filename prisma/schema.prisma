model OnlineOrder {
  id                 String     @id @default(cuid())
  restaurantId       String
  customerName       String
  customerPhone      String
  orderType          String
  deliveryAddress    String?
  paymentMethod      String
  items              Json
  total              Int
  notes              String?
  status             String     @default("PENDING")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  customerEmail      String?
  cancellationReason String?
  statusHistory      Json       @default("[]")
  paymentStatus      String     @default("pending")
  paymentGateway     String?
  webpayToken        String?
  webpayBuyOrder     String?
  paidAt             DateTime?
  orderNumber        Int?
  toteatOrderId      String?
  posError           String?
  deliveryFee        Int        @default(0)
  flowToken          String?
  discount           Int        @default(0)
  couponCode         String?
  source             String     @default("pedir-online")
  deliveryLat        Float?
  deliveryLng        Float?
  uberDeliveryId     String?
  courier            Json?
  surveySentAt       DateTime?
  printedAt          DateTime?
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
  @@index([restaurantId, createdAt])
}

/// Pedido del POS (Toteat) ingresado por webhook. Es el "Centro de pedidos":
/// captura TODO lo que entra a Toteat (mesa, retiro, delivery, cualquier canal)
/// y le agrega una etapa operativa propia gestionable por el local.
model PosOrder {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  externalId String // orderId de Toteat (único por local)
  provider   String @default("toteat")

  // Estado que reporta Toteat (mapeado): new | preparing | ready | on_the_way | delivered | canceled | accepted
  posStatus String @default("new")
  // Etapa operativa gestionada por el local: preparing | ready | out_for_delivery | delivered
  opsStage       String    @default("preparing")
  opsDeliveredAt DateTime?

  saleType   String  @default("") // dine-in | delivery | pickup | ...
  isDelivery Boolean @default(false)
  tableLabel String? // "Mesa 3" cuando aplica

  customerName  String @default("")
  customerPhone String @default("")
  addressLine   String @default("")

  totalAmount    Int    @default(0)
  paidAmount     Int    @default(0)
  tipAmount      Int    @default(0)
  changeAmount   Int    @default(0)
  deliveryFee    Int    @default(0)
  discountAmount Int    @default(0)
  currency       String @default("CLP")

  vendorName     String?
  orderReference String?

  items      Json? // líneas normalizadas del pedido
  rawPayload Json? // payload crudo de Toteat (para depurar/reprocesar)

  completedAt DateTime? // cuándo Toteat lo cerró/entregó
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ── Reparto / despacho (app de repartidor) ──
  assignedDriverId String?
  assignedDriver   Driver? @relation(fields: [assignedDriverId], references: [id])
  assignedTo       String? // nombre del repartidor asignado (compat con la app)
  isAssigned       Boolean @default(false)
  opsReadyForDeliveryAt DateTime?
  opsDispatchedAt       DateTime?

  // Geo del cliente (para el mapa)
  customerLat Float?
  customerLng Float?

  // Tracking en vivo (GPS del repartidor)
  trackingToken     String?   @unique
  trackingLastPingAt DateTime?
  lastLat        Float?
  lastLng        Float?
  lastAccuracyM  Float?
  lastSpeedMps   Float?
  lastHeadingDeg Float?

  // Courier externo (Uber Direct / PedidosYa)
  courier        Json? // CourierInfo (nombre/tel/foto/ubicación/tracking/POD)
  uberDeliveryId String?
  pyaShippingId  String?

  resends   PosOrderResend[]
  locations PosDriverLocation[]

  @@unique([restaurantId, externalId])
  @@index([restaurantId])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, opsStage])
  @@index([assignedDriverId])
}

/// Repartidor de un local (login de la app). Multi-tenant por restaurantId.
model Driver {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  username      String
  displayName   String
  passwordHash  String
  role          String     @default("driver") // driver | admin
  active        Boolean    @default(true)
  isOnShift     Boolean    @default(false)
  shiftStartedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions       DriverSession[]
  assignedOrders PosOrder[]

  @@unique([restaurantId, username])
  @@index([restaurantId])
}

/// Token de sesión de la app del repartidor (Bearer).
model DriverSession {
  id         String    @id @default(cuid())
  driverId   String
  driver     Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  token      String    @unique
  platform   String?
  deviceName String?
  appVersion String?
  lastSeenAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([driverId])
}

/// Responsables del local (roster para reasignaciones/reenvíos).
model DeliveryResponsible {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  roleLabel    String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

/// Reasignación/reenvío de un pedido a otro responsable (con delivery extra).
model PosOrderResend {
  id                  String   @id @default(cuid())
  posOrderId          String
  posOrder            PosOrder @relation(fields: [posOrderId], references: [id], onDelete: Cascade)
  responsibleId       String?
  responsibleName     String
  extraDeliveryAmount Int      @default(0)
  createdByDriverId   String?
  createdByDriverName String?
  createdAt           DateTime @default(now())

  @@index([posOrderId])
}

/// Historial de ubicaciones GPS del repartidor (rastro del tracking).
model PosDriverLocation {
  id           String   @id @default(cuid())
  posOrderId   String
  posOrder     PosOrder @relation(fields: [posOrderId], references: [id], onDelete: Cascade)
  driverId     String?
  lat          Float
  lng          Float
  accuracyM    Float?
  speedMps     Float?
  headingDeg   Float?
  batteryLevel Float?
  createdAt    DateTime @default(now())

  @@index([posOrderId, createdAt])
}

/// Bitácora de cada intento entrante al webhook de Toteat (diagnóstico). Permite
/// ver si Toteat está llegando, y por qué se acepta/rechaza, sin depender de los
/// logs de Vercel. restaurantId es null cuando el token no calzó con ningún local.
model PosWebhookLog {
  id           String   @id @default(cuid())
  restaurantId String? // local resuelto por token (null = token no reconocido)
  ok           Boolean  @default(false)
  reason       String // "ok" | "unauthorized" | "invalid_json" | "no_orders" | ...
  processed    Int      @default(0)
  tokenPreview String? // primeros/últimos chars del token recibido
  tokenVia     String? // "header" | "query" | "none"
  headerKeys   String? // nombres de headers recibidos (para detectar cómo manda el token Toteat)
  method       String?
  ip           String?
  bodyPreview  String? // primeros ~600 chars del body
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([createdAt])
}

model EcommerceCouponUse {
  id            String   @id @default(cuid())
  restaurantId  String
  couponCode    String
  orderId       String?
  customerPhone String?
  createdAt     DateTime @default(now())

  @@index([restaurantId, couponCode])
}

model Invoice {
  id           String     @id @default(cuid())
  restaurantId String
  folio        Int
  tipoDTE      Int
  total        Int
  periodo      String?
  status       String     @default("EMITIDA")
  emittedAt    DateTime   @default(now())
  metadata     Json?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model MenuGroup {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  description  String?
  imageUrl     String?
  position     Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  categories   Category[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, slug])
  @@index([restaurantId])
}

model ToteatSale {
  id              String              @id @default(cuid())
  restaurantId    String
  toteatOrderId   BigInt              @unique
  toteatTableId   String?
  toteatTableName String?
  numberClients   Int?
  toteatWaiterId  BigInt?
  waiterName      String?
  dateOpen        DateTime
  dateClosed      DateTime
  total           Float
  payed           Float
  gratuity        Float               @default(0)
  subtotal        Float
  taxes           Float               @default(0)
  fiscalType      String?
  paymentMethod   String?
  rawJson         Json
  syncedAt        DateTime            @default(now())
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id])
  products        ToteatSaleProduct[]

  @@index([restaurantId, dateClosed])
  @@index([restaurantId, toteatTableId])
}

model ToteatSaleProduct {
  id              String     @id @default(cuid())
  saleId          String
  toteatProductId String
  productName     String
  hierarchyId     String?
  hierarchyName   String?
  quantity        Float
  netPrice        Float
  payed           Float
  taxes           Float      @default(0)
  discounts       Float      @default(0)
  sale            ToteatSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([toteatProductId])
}

model BadgeSnapshot {
  id           String     @id @default(cuid())
  restaurantId String
  dishId       String
  badgeType    String
  score        Float?
  position     Int?
  capturedAt   DateTime   @default(now())
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, badgeType, capturedAt])
  @@index([dishId, capturedAt])
}

model AbExperiment {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  variants    AbVariant[]

  @@index([slug])
}

model AbVariant {
  id           String       @id @default(cuid())
  experimentId String
  slot         String
  text         String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  experiment   AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, slot, isActive])
}

model Announcement {
  id           String     @id @default(cuid())
  restaurantId String
  text         String
  linkUrl      String?
  daysOfWeek   Int[]
