generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id                String    @id @default(cuid())
  nombre            String
  email             String    @unique
  password          String
  telefono          String?
  ciudad            String?   @default("santiago")
  fotoUrl           String    @default("")
  tipo              String    @default("usuario")
  emailVerificado   Boolean   @default(false)
  emailVerificadoAt DateTime?
  tokenVerificacion String?
  resetToken        String?
  resetTokenExpira  DateTime?
  estiloAlimentario String    @default("")
  comidasFavoritas  String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Local {
  id          String     @id @default(cuid())
  slug        String?    @unique
  nombre      String
  email       String     @unique
  password    String
  telefono    String?
  ciudad      String     @default("santiago")
  categorias  String[]   @default([])
  descripcion String?
  direccion   String?
  comuna      String?
  lat         Float?
  lng         Float?
  instagram   String?
  sitioWeb    String?
  horarios    Json?
  logoUrl     String?
  portadaUrl  String?
  activo      Boolean    @default(true)
  vistas      Int        @default(0)
  linkPedido  String?    @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  menuItems   MenuItem[]

  @@index([activo])
  @@index([comuna])
}

model MenuItem {
  id             String          @id @default(cuid())
  localId        String
  categoria      String
  nombre         String
  descripcion    String?
  precio         Float
  imagenUrl      String?
  destacado      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  ingredients    String[]
  hungerLevel    HungerLevel?
  isAvailable    Boolean         @default(true)
  availableFrom  String?
  availableTo    String?
  totalViews     Int             @default(0)
  totalSelected  Int             @default(0)
  totalLoved     Int             @default(0)
  avgRating      Float?
  dietType       DietType        @default(OMNIVORE)
  mealTimes      String[]        @default([])
  ratings        DishRating[]
  ingredientTags IngredientTag[]
  interactions   Interaction[]
  local          Local           @relation(fields: [localId], references: [id])
}

model Ingredient {
  id                    String             @id @default(cuid())
  name                  String             @unique
  category              IngredientCategory
  createdAt             DateTime           @default(now())
  aliases               String[]
  nameEn                String?
  namePt                String?
  createdByRestaurantId String?
  approved              Boolean            @default(true)
  dishIngredients       DishIngredient[]
  createdByRestaurant   Restaurant?        @relation("CreatedIngredients", fields: [createdByRestaurantId], references: [id])
  dishes                IngredientTag[]
  allergens             Allergen[]         @relation("AllergenToIngredient")
}

model Allergen {
  id          String       @id @default(cuid())
  name        String       @unique
  position    Int          @default(0)
  createdAt   DateTime     @default(now())
  type        AllergenType @default(ALLERGEN)
  ingredients Ingredient[] @relation("AllergenToIngredient")
}

model IgnoredIngredient {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model IngredientTag {
  id           String     @id @default(cuid())
  menuItemId   String
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id])

  @@unique([menuItemId, ingredientId])
}

model Interaction {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  userId           String?
  sessionId        String
  visitId          String?
  menuItemId       String
  action           InteractionAction
  ctxCompany       CompanyContext?
  ctxHunger        HungerLevel?
  ctxBudget        Int?
  ctxOccasion      OccasionContext?
  weatherTemp      Float?
  weatherCondition String?
  weatherHumidity  Int?
  userLat          Float?
  userLng          Float?
  hour             Int?
  dayOfWeek        Int?
  menuItem         MenuItem          @relation(fields: [menuItemId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([visitId])
  @@index([menuItemId])
}

model DishRating {
  id         String      @id @default(cuid())
  createdAt  DateTime    @default(now())
  userId     String?
  sessionId  String
  menuItemId String
  score      RatingScore
  comment    String?
  stars      Int?
  userName   String?
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id])

  @@unique([userId, menuItemId])
  @@index([menuItemId])
}

model UserTasteProfile {
  id                  String          @id @default(cuid())
  updatedAt           DateTime        @updatedAt
  userId              String          @unique
  sessionId           String?
  favoriteIngredients String[]
  avoidIngredients    String[]
  typicalHunger       HungerLevel?
  typicalCompany      CompanyContext?
  typicalBudget       Int?
  coldWeatherPrefs    String[]
  hotWeatherPrefs     String[]
  onboardingDone      Boolean         @default(false)
  dietaryRestrictions String[]
  riskProfile         RiskProfile     @default(BALANCED)
  fitnessMode         FitnessMode?
  fitnessUpdatedAt    DateTime?
}

model RestaurantOwner {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  name               String
  role               OwnerRole          @default(OWNER)
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  resetToken         String?
  resetTokenExpiry   DateTime?
  status             OwnerStatus        @default(ACTIVE)
  mustChangePassword Boolean            @default(false)
  whatsapp           String?
  seenFeatures       String[]           @default([])
  emailVerificado    Boolean   @default(false)
  emailVerificadoAt  DateTime?
  restaurants        Restaurant[]
  uploadedTickets    RestaurantTicket[]

  @@index([resetToken])
}

model TeamMember {
  id                 String           @id @default(cuid())
  restaurantId       String
  email              String
  name               String
  role               TeamRole         @default(VIEWER)
  status             TeamMemberStatus @default(PENDING)
  weeklyEmailEnabled Boolean          @default(true)
  seenFeatures       String[]         @default([])
  passwordHash       String?
  inviteToken        String?          @unique
  inviteExpiresAt    DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  restaurant         Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, email])
  @@index([email])
  @@index([inviteToken])
}

model Restaurant {
  id                         String                   @id @default(cuid())
  slug                       String                   @unique
  name                       String
  description                String?
  logoUrl                    String?
  bannerUrl                  String?
  phone                      String?
  address                    String?
  cartaTheme                 CartaTheme               @default(BASIC)
  isActive                   Boolean                  @default(true)
  ownerId                    String?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  defaultView                String?
  waiterPanelActive          Boolean                  @default(false)
  qrActivatedAt              DateTime?
  instagram                  String?
  scheduleJson               Json?
  website                    String?
  websiteIsOrderUrl          Boolean                  @default(false)
  cartaProvider              String?
  whatsapp                   String?
  qrToken                    String?                  @unique
  allPhotosReferential       Boolean                  @default(false)
  dietType                   DishDietType             @default(OMNIVORE)
  enabledLangs               String[]                 @default(["es", "en", "pt"])
  plan                       RestaurantPlan           @default(FREE)
  toteatApiToken             String?
  toteatLastSyncAt           DateTime?
  toteatLocalId              Int?
  toteatRestaurantId         String?
  toteatUserId               Int?
  currentPeriodEnd           DateTime?
  flowCustomerId             String?                  @unique
  flowPlanId                 String?
  flowSubscriptionId         String?                  @unique
  lastPaymentAt              DateTime?
  subscriptionStatus         SubscriptionStatus       @default(NONE)
  trialEndsAt                DateTime?
  flowRegisterToken          String?
  pendingFlowPlanId          String?
  billingAnchorDay           Int?
  billingExempt              Boolean                  @default(false)
  toteatImportDone           Boolean                  @default(false)
  toteatLastVisibilitySyncAt DateTime?
  toteatWebhookSecret        String?                  @unique
  billingAddress             String?
  billingCity                String?
  billingCompanyName         String?
  billingContactName         String?
  billingEmail               String?
  billingGiro                String?
  billingPhone               String?
  billingRut                 String?
  birthdayPerk               String?
  trialReminderSentAt        DateTime?
  // ── Loyalty billing ──────────────────────────────────────────
  loyaltyStatus              SubscriptionStatus       @default(NONE)
  loyaltyPeriodEnd           DateTime?
  loyaltyTrialEndsAt         DateTime?
  loyaltyLastPaymentAt       DateTime?
  loyaltyTrialReminderSentAt DateTime?
  loyaltyFlowRegisterToken   String?
  // ─────────────────────────────────────────────────────────────
  birthdayEmailEnabled       Boolean                  @default(false)
  birthdayPerkConditions     String?
  cartaColorMode             CartaColorMode           @default(LIGHT)
  cartaAccentColor           String?
  sectionTitleMenu           String?
  sectionTitleRecomendados   String?
  sectionTitleCraving        String?
  isDemo                     Boolean                  @default(false)
  isShowcase                 Boolean                  @default(false)
  needsTranslation           Boolean                  @default(false)
  weeklyEmailEnabled         Boolean                  @default(true)
  weeklyInsightsEnabled      Boolean                  @default(true)
  demoOnboardingDone         Boolean                  @default(false)
  mpCustomerId               String?                  @unique
  mpPlanId                   String?
  mpSubscriptionId           String?                  @unique
  pendingMpPlanId            String?
  menuImported               Boolean                  @default(false)
  showCategoryLobby          Boolean                  @default(false)
  customPlanPriceNet         Int?
  mpPayerEmail               String?
  genioFabEnabled            Boolean                  @default(false)
  ownerBannerEnabled         Boolean                  @default(false)
  multiMenuEnabled           Boolean                  @default(false)
  filterBarEnabled           Boolean                  @default(true)
  lat                        Float?
  lng                        Float?
  googleMapsUrl              String?
  googlePlaceId              String?
  googleRating               Float?
  googleRatingCount          Int?
  primaryCategory            String?
  // Pedidos online (wa.me) — solo plan PREMIUM
  orderingEnabled            Boolean                  @default(false)
  orderingPhone              String? // WA destino (override del whatsapp del local)
  orderingDelivery           String                   @default("BOTH") // PICKUP | DELIVERY | BOTH
  orderingMinAmount          Int? // Monto mínimo en pesos CLP
  orderingWaitTime           String? // Ej: "30-45 min"
  orderingNote               String? // Mensaje custom visible en checkout
  orderingPaymentMethods     String                   @default("efectivo,transferencia,tarjeta") // métodos disponibles
  orderingBannerUrl          String? // banner personalizado para /pedir
  orderingTheme              String                   @default("light") // light | dark
  orderingAccentColor        String? // color de acento hex
  orderingMode               String                   @default("whatsapp") // "whatsapp" | "panel"
  orderingBusinessHours      Json?                    // { "0": { open: bool, from: "HH:mm", to: "HH:mm" }, ..., "6": ... } (0=Dom)
  orderingShowFeatured       Boolean                  @default(true) // mostrar el banner/hero de productos destacados en /pedir
  // Valoraciones
  reviewMode                 String                   @default("off") // "off" | "google" | "private"
  googleReviewUrl            String? // URL de Google Maps para dejar reseña
  reviewReward               String? // Descripción del premio (null = sin premio)
  privateReviews             PrivateReview[]
  announcements              Announcement[]
  automationRules            AutomationRule[]
  badgeSnapshots             BadgeSnapshot[]
  birthdays                  BirthdayCampaign[]
  birthdayEmailLogs          BirthdayEmailLog[]
  campaigns                  Campaign[]
  categories                 Category[]
  customers                  Customer[]
  dishes                     Dish[]
  dishFavorites              DishFavorite[]
  dishSuggestions            DishSuggestion[]
  experience                 Experience?
  genioInsights              GenioInsight[]
  happyHours                 HappyHour[]
  createdIngredients         Ingredient[]             @relation("CreatedIngredients")
  menuGroups                 MenuGroup[]
  modifierTemplates          ModifierTemplate[]
  promotionsMarketing        Promotion[]
  qrUserInteractions         QRUserInteraction[]
  owner                      RestaurantOwner?         @relation(fields: [ownerId], references: [id])
  restaurantClients          RestaurantClient[]
  promotions                 RestaurantPromotion[]
  schedules                  RestaurantScheduleRule[]
  tables                     RestaurantTable[]
  tickets                    RestaurantTicket[]
  reviews                    Review[]
  segments                   Segment[]
  sessions                   Session[]
  statEvents                 StatEvent[]
  teamMembers                TeamMember[]
  toteatSales                ToteatSale[]
  waiterCalls                WaiterCall[]
  onlineOrders               OnlineOrder[]
  waiterSubscriptions        WaiterPushSubscription[]
  orderPushSubscriptions     OrderPushSubscription[]
  whatsappMessages           WhatsAppMessage[]
  invoices                   Invoice[]
  // Módulo Control
  controlEnabled             Boolean                  @default(false)
  insumos                    Insumo[]
  compras                    Compra[]
  conteos                    Conteo[]
  mermas                     Merma[]
  ventasDia                  VentaDia[]
  hojasImpresas              HojaImpresa[]
  // Módulo Financiero
  financialEnabled           Boolean                  @default(false)
  financialCategories        FinancialCategory[]
  financialEntries           FinancialEntry[]
  bankMovements              BankMovement[]
  cashAgents                 CashAgent[]
  categorizationRules        CategorizationRule[]
  fintocLinkToken            String?
  fintocAccountId            String?
  fintocLastSync             DateTime?

  commune     String?
  communeSlug String?
  profileType String   @default("RESTAURANT") // "RESTAURANT" | "STORE"

  @@index([ownerId])
  @@index([communeSlug])
}

model OnlineOrder {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  customerName    String
  customerPhone   String
  customerEmail   String?
  orderType       String // "PICKUP" | "DELIVERY"
  deliveryAddress String?
  paymentMethod   String // "efectivo" | "transferencia" | "tarjeta"
  items           Json // CartItem[]
  total           Int
  notes           String?
  cancellationReason String?

  // PENDING → ACCEPTED → PREPARING → IN_DELIVERY (delivery) | READY (pickup) → DONE | CANCELLED
  status        String @default("PENDING")
  statusHistory Json   @default("[]") // Array<{ status: string; ts: string }>

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([restaurantId, createdAt])
}

model Invoice {
  id           String     @id @default(cuid())
  restaurantId String
  folio        Int
  tipoDTE      Int
  total        Int
  periodo      String?
  status       String     @default("EMITIDA")
  emittedAt    DateTime   @default(now())
  metadata     Json?
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model MenuGroup {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  slug         String
  description  String?
  imageUrl     String?
  position     Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  categories   Category[]
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([restaurantId, slug])
  @@index([restaurantId])
}

model ToteatSale {
  id              String              @id @default(cuid())
  restaurantId    String
  toteatOrderId   BigInt              @unique
  toteatTableId   String?
  toteatTableName String?
  numberClients   Int?
  toteatWaiterId  BigInt?
  waiterName      String?
  dateOpen        DateTime
  dateClosed      DateTime
  total           Float
  payed           Float
  gratuity        Float               @default(0)
  subtotal        Float
  taxes           Float               @default(0)
  fiscalType      String?
  paymentMethod   String?
  rawJson         Json
  syncedAt        DateTime            @default(now())
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id])
  products        ToteatSaleProduct[]

  @@index([restaurantId, dateClosed])
  @@index([restaurantId, toteatTableId])
}

model ToteatSaleProduct {
  id              String     @id @default(cuid())
  saleId          String
  toteatProductId String
  productName     String
  hierarchyId     String?
  hierarchyName   String?
  quantity        Float
  netPrice        Float
  payed           Float
  taxes           Float      @default(0)
  discounts       Float      @default(0)
  sale            ToteatSale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([toteatProductId])
}

model BadgeSnapshot {
  id           String     @id @default(cuid())
  restaurantId String
  dishId       String
  badgeType    String
  score        Float?
  position     Int?
  capturedAt   DateTime   @default(now())
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId, badgeType, capturedAt])
  @@index([dishId, capturedAt])
}

model AbExperiment {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  variants    AbVariant[]

  @@index([slug])
}

model AbVariant {
  id           String       @id @default(cuid())
  experimentId String
  slot         String
  text         String
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  experiment   AbExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, slot, isActive])
}

model Announcement {
  id           String     @id @default(cuid())
  restaurantId String
  text         String
  linkUrl      String?
  daysOfWeek   Int[]
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean    @default(true)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])

  @@index([restaurantId])
}

model Category {
  id            String                @id @default(cuid())
  restaurantId  String
  name          String
  description   String?
  position      Int
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  dishType      String                @default("food")
  menuGroupId   String?
  normOverride  String?
  cuisineTag    String?
  scheduleDays  Int[]
  scheduleStart String?
  scheduleEnd   String?
  menuGroup     MenuGroup?            @relation(fields: [menuGroupId], references: [id])
  restaurant    Restaurant            @relation(fields: [restaurantId], references: [id])
  translations  CategoryTranslation[]
  dishes        Dish[]

  @@index([restaurantId])
  @@index([menuGroupId])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  lang       String
  name       String
  isManual   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
  @@index([categoryId])
}

model Dish {
  id                    String                 @id @default(cuid())
  restaurantId          String
  categoryId            String
  name                  String
  description           String?
  price                 Float
  discountPrice         Float?
  photos                String[]
  tags                  DishTag[]
  isHero                Boolean                @default(false)
  isActive              Boolean                @default(true)
  stockCountdown        Int?
  ingredients           String?
  allergens             String?
  position              Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  dishDiet              DishDietType           @default(OMNIVORE)
  isSpicy               Boolean                @default(false)
  deletedAt             DateTime?
  flavorTags            String[]
  txDishType            String[]
  txCuisine             String[]
  txMealSlot            String[]
  txIngredient          String[]
  txEstilo              String[]
  isFeaturedAuto        Boolean                @default(false)
  isHighMargin          Boolean                @default(false)
  isPhotoReferential    Boolean                @default(false)
  isGlutenFree          Boolean                @default(false)
  isLactoseFree         Boolean                @default(false)
  isSoyFree             Boolean                @default(false)
  toteatMappedAt        DateTime?
  toteatMappedBy        String?
  toteatProductId       String?
  toteatSynced          Boolean                @default(false)
  toteatNoDirectMapping Boolean                @default(false)
  containsNuts          Boolean                @default(false)
  photoCredits          Json?
  embedding             Unsupported("vector")?
  embeddingHash         String?
  embeddingText         String?
  imageEmbedding        Unsupported("vector")?
  imageEmbeddingHash    String?
  hiddenFromFeed        Boolean                @default(false)
  leafOverride          String?
  badgeSnapshots        BadgeSnapshot[]
  category              Category               @relation(fields: [categoryId], references: [id])
  restaurant            Restaurant             @relation(fields: [restaurantId], references: [id])
  dishFavorites         DishFavorite[]
  dishIngredients       DishIngredient[]
  suggestedWith         DishSuggestion[]       @relation("SuggestionFrom")
  suggestedBy           DishSuggestion[]       @relation("SuggestionTo")
  translations          DishTranslation[]
  feedComments          FeedComment[]
  feedStats             FeedDishStats?
  feedInteractions      FeedInteraction[]
  feedRatings           FeedRating[]
  feedSaved             FeedSaved[]
  reviews               Review[]
  modifierTemplates     ModifierTemplate[]     @relation("DishToModifierTemplate")

  @@index([restaurantId, toteatProductId])
  @@index([restaurantId])
  @@index([categoryId])
}

model DishSuggestion {
  id              String     @id @default(cuid())
  dishId          String
  suggestedDishId String
  restaurantId    String
  createdAt       DateTime   @default(now())
  dish            Dish       @relation("SuggestionFrom", fields: [dishId], references: [id], onDelete: Cascade)
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  suggestedDish   Dish       @relation("SuggestionTo", fields: [suggestedDishId], references: [id], onDelete: Cascade)

  @@unique([dishId, suggestedDishId])
  @@index([dishId])
  @@index([restaurantId])
}

model DishTranslation {
  id          String   @id @default(cuid())
  dishId      String
  lang        String
  description String?
  isManual    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String?
  dish        Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([dishId, lang])
  @@index([dishId])
}

model ModifierTemplate {
  id           String                  @id @default(cuid())
  restaurantId String
  name         String
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  scope        String                  @default("product")
  restaurant   Restaurant              @relation(fields: [restaurantId], references: [id])
  groups       ModifierTemplateGroup[]
  dishes       Dish[]                  @relation("DishToModifierTemplate")
  promotions   Promotion[]             @relation("ModifierTemplateToPromotion")

  @@index([restaurantId])
  @@index([restaurantId, scope])
}

model ModifierTemplateGroup {
  id           String                     @id @default(cuid())
  templateId   String
  name         String
  required     Boolean                    @default(false)
  minSelect    Int                        @default(0)
  maxSelect    Int                        @default(1)
  position     Int                        @default(0)
  translations ModifierGroupTranslation[]
  template     ModifierTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options      ModifierTemplateOption[]

  @@index([templateId])
}

model ModifierTemplateOption {
  id              String                      @id @default(cuid())
  groupId         String
  name            String
  priceAdjustment Float                       @default(0)
  isDefault       Boolean                     @default(false)
  position        Int                         @default(0)
  description     String?
  imageUrl        String?
  isHidden        Boolean                     @default(false)
  toteatMappedAt  DateTime?
  toteatMappedBy  String?
  toteatProductId String?
  translations    ModifierOptionTranslation[]
  group           ModifierTemplateGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([toteatProductId])
}

model ModifierGroupTranslation {
  id       String                @id @default(cuid())
  groupId  String
  lang     String
  name     String
  isManual Boolean               @default(false)
  group    ModifierTemplateGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, lang])
  @@index([groupId])
}

model ModifierOptionTranslation {
  id          String                 @id @default(cuid())
  optionId    String
  lang        String
  name        String
  description String?
  isManual    Boolean                @default(false)
