// ═══════════════════════════════════════════════════════════════
// LOYALTY — Tarjetas de membresía (Apple / Google Wallet)
// Mecánica de SELLOS (junta X sellos → recompensa).
// Tablas autocontenidas: no modifican modelos existentes.
// ═══════════════════════════════════════════════════════════════

model LoyaltyProgram {
  id           String  @id @default(cuid())
  restaurantId String  @unique
  name         String  @default("Tarjeta de fidelidad")
  active       Boolean @default(false)

  // Mecánica de sellos
  stampGoal Int    @default(8) // cantidad total de sellos de la tarjeta
  stampIcon String @default("★") // símbolo/emoji del sello (elegido por el restaurante)
  // Niveles de recompensa: array JSON de { stamp: number, reward: string }
  // Ej: [{ "stamp": 3, "reward": "Un café gratis" }, { "stamp": 8, "reward": "Un combo gratis" }]
  rewards Json @default("[]")

  // Diseño de la tarjeta en el wallet
  cardColorHex  String  @default("#111111") // color de fondo de la tarjeta
  stampColorHex String  @default("#FFFFFF") // color de fondo de los sellos
  bgImageUrl    String? // imagen de fondo de la tarjeta (foto de un plato de la carta)
  logoUrl       String?
  description   String? // condiciones/letra chica que se muestra al pie de la tarjeta
  heroText      String? // texto descriptivo del hero en la página de inscripción

  showGiftBadge Boolean @default(true) // mostrar el 🎁 en las casillas de recompensa

  // Vencimiento de tarjeta (días de inactividad, null = sin vencimiento)
  cardExpiryDays Int?

  // Acceso al escáner (app de empleados sin login)
  scanToken    String?  @unique // token en la URL que autentica el escáner
  scanPinHash  String?          // PIN hasheado (bcrypt) para primer acceso
  scanEnabled  Boolean  @default(true)

  // Geo-notificaciones (aviso al cliente cuando está cerca del local)
  geoEnabled  Boolean @default(false)
  geoRadiusKm Float   @default(1) // radio en km (principalmente para Apple)
  geoMessage  String? // texto que aparece al estar cerca

  // Última notificación enviada (se muestra como "Novedades" en el pase de Apple)
  pushMessage String?

  // Notificación automática de cumpleaños
  birthdayEnabled Boolean @default(false)
  birthdayTitle   String? // ej: "¡Feliz cumpleaños!" (opcional)
  birthdayMessage String? // ej: "Hoy es tu día 🎂 Ven a celebrar con nosotros"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members LoyaltyMember[]

  @@index([restaurantId])
}

model LoyaltyMember {
  id           String @id @default(cuid())
  programId    String
  restaurantId String

  name      String?
  email     String?
  phone     String?
  birthDate DateTime?

  stamps         Int     @default(0) // sellos en la tarjeta vigente (0..stampGoal)
  redeemedTiers  Int[]   @default([]) // números de sello ya canjeados en el ciclo actual
  completedCards Int     @default(0) // tarjetas completadas (histórico)
  revoked        Boolean @default(false) // pase revocado (anulado en Apple, expirado en Google)

  // Identificadores de wallet para poder actualizar la tarjeta en el teléfono
  appleSerial    String? @unique // serialNumber del .pkpass (Apple)
  googleObjectId String? @unique // object id (Google Wallet)
  authToken      String  @default(cuid()) // token del web service de Apple Wallet

  enrolledAt          DateTime  @default(now())
  lastStampAt         DateTime?
  lastGeoNotifAt      DateTime? // última vez que se envió notif por cercanía (rate-limit)
  lastBirthdayNotifAt DateTime? // última vez que se envió notif de cumpleaños (para no duplicar en el año)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  program      LoyaltyProgram       @relation(fields: [programId], references: [id])
  transactions LoyaltyTransaction[]

  @@index([programId])
  @@index([restaurantId])
  @@index([email])
}

model LoyaltyTransaction {
  id        String        @id @default(cuid())
  memberId  String
  type      LoyaltyTxType
  amount    Int           @default(1)
  note      String?
  createdAt DateTime      @default(now())

  member LoyaltyMember @relation(fields: [memberId], references: [id])

  @@index([memberId])
}

enum LoyaltyTxType {
  STAMP_ADD // se agregó un sello
  STAMP_REMOVE // se quitó un sello (corrección)
  REWARD_EARN // se completó la tarjeta → recompensa ganada
  REWARD_REDEEM // el cliente canjeó la recompensa
}

// Dispositivos iOS registrados para recibir actualizaciones del pase (PassKit Web Service).
model LoyaltyDevice {
  id                      String   @id @default(cuid())
  deviceLibraryIdentifier String
  pushToken               String
  passTypeIdentifier      String
  serialNumber            String // = LoyaltyMember.id
  createdAt               DateTime @default(now())

  @@unique([deviceLibraryIdentifier, serialNumber])
  @@index([serialNumber])
}

// Reseñas privadas (modo privado de Valoraciones)
model PrivateReview {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  rating       Int        // 1–5
  comment      String?
  authorName   String?
  isRead       Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, createdAt])
}

// Historial de notificaciones push enviadas a las tarjetas.
model PanelShortLink {
  id        Int      @id @default(autoincrement()) // URL corta: quierocomer.com/panel/1
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model LoyaltyBroadcast {
  id           String   @id @default(cuid())
  restaurantId String
  title        String
  body         String
  recipients   Int      @default(0)
  filter       String   @default("all") // "all" | "birthday_today" | "birthday_week" | "loyal" | "active" | "inactive" | "no_stamps"
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
}

// Visitas ligeras a páginas del local (landing, pedir, fidelidad, resena).
// La carta QR ya se trackea en Session — aquí se registran las demás.
model PageHit {
  id           String   @id @default(cuid())
  restaurantId String
  page         String   // "landing" | "pedir" | "fidelidad" | "resena"
  createdAt    DateTime @default(now())

  @@index([restaurantId, page, createdAt])
  @@index([restaurantId, createdAt])
}

// ── Módulo Financiero ─────────────────────────────────────────────────────────

model FinancialCategory {
  id           String           @id @default(cuid())
  restaurantId String
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  type         FinancialType    // INCOME | EXPENSE
  group        String?          // "Proveedores", "Operaciones", "Administración", etc.
  color        String?          // hex, ej: "#22c55e"
  icon         String?          // emoji
  position     Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  entries      FinancialEntry[]

  @@index([restaurantId, type])
}

model FinancialEntry {
  id             String            @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId     String
  category       FinancialCategory @relation(fields: [categoryId], references: [id])
  amount         Int               // CLP, siempre positivo
  type           FinancialType
  date           DateTime          // fecha del movimiento (no del ingreso al sistema)
  description    String?
  source         EntrySource       @default(MANUAL)
  bankMovementId String?           // sin @unique — permite múltiples entries por movimiento (splits)
  bankMovement   BankMovement?     @relation(fields: [bankMovementId], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([restaurantId, date])
  @@index([restaurantId, categoryId])
  @@index([bankMovementId])
}

model BankMovement {
  id              String          @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date            DateTime
  description     String
  debit           Int?            // egreso en CLP (positivo)
  credit          Int?            // ingreso en CLP (positivo)
  balance         Int?            // saldo después del movimiento
  source          String          @default("BCI_XLSX") // "BCI_XLSX" | "BANK_API"
  externalKey     String?         // hash para dedup: evita reimportar mismo movimiento
  status          MovementStatus  @default(PENDING)
  agentId         String?         // → CashAgent si este movimiento es retiro a un agente
  agent           CashAgent?      @relation(fields: [agentId], references: [id])
  suggestedCatId  String?         // categoría sugerida automáticamente (single, no split)
  entries         FinancialEntry[]
  createdAt       DateTime        @default(now())

  @@index([restaurantId, date])
  @@index([restaurantId, status])
  @@unique([restaurantId, externalKey])
}

// Agente de compras: persona que retira plata de la cuenta y compra cosas (universal)
model CashAgent {
  id           String        @id @default(cuid())
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String        // "Carlos Gómez"
  bankPatterns String[]      // ["Carlos Gómez", "Carlos Gomez"] — substrings a buscar en descripción BCI
  flujoToken   String?       @unique // token para /flujo (si tiene cuenta)
  isActive     Boolean       @default(true)
  movements    BankMovement[]
  createdAt    DateTime      @default(now())

  @@index([restaurantId])
}

// Regla de auto-categorización aprendida por uso
model CategorizationRule {
  id           String                   @id @default(cuid())
  restaurantId String
  restaurant   Restaurant               @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  pattern      String                   // substring a buscar en la descripción del movimiento
  isSplit      Boolean                  @default(false)
  categoryId   String?                  // categoría para el caso simple (no split)
  usageCount   Int                      @default(1)
  confidence   Float                    @default(1.0) // 0-1, sube con cada confirmación
  createdAt    DateTime                 @default(now())
  lastUsedAt   DateTime                 @default(now())
  splits       CategorizationRuleSplit[]

  @@unique([restaurantId, pattern])
  @@index([restaurantId])
}

// Porciones de una regla de split: cómo distribuir el monto entre categorías
model CategorizationRuleSplit {
  id         String              @id @default(cuid())
  ruleId     String
  rule       CategorizationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  categoryId String
  ratio      Float               // 0.0-1.0, todos los splits de una regla deben sumar 1.0
  label      String?             // etiqueta opcional: "Gastos operativos"

  @@index([ruleId])
}

enum MovementStatus {
  PENDING     // sin categoría asignada
  SUGGESTED   // auto-detectado, esperando confirmación del usuario
  RECONCILED  // categorizado y confirmado → tiene FinancialEntry(s)
  IGNORED     // descartado (movimiento interno, duplicado, etc.)
}

enum FinancialType {
  INCOME
  EXPENSE
}

enum EntrySource {
  MANUAL      // ingresado a mano desde el panel /panel flujo
  FLUJO       // registrado por un agente desde /flujo (ej: Carlos Gómez)
  BANK_CSV
  BANK_API
}
