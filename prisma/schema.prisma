  restaurantId String
  title        String
  body         String
  recipients   Int      @default(0)
  createdAt    DateTime @default(now())
  filter       String   @default("all")

  @@index([restaurantId, createdAt])
}

model PageHit {
  id           String   @id @default(cuid())
  restaurantId String
  page         String
  createdAt    DateTime @default(now())

  @@index([restaurantId, page, createdAt])
  @@index([restaurantId, createdAt])
}

model FinancialCategory {
  id           String           @id @default(cuid())
  restaurantId String
  name         String
  type         FinancialType
  color        String?
  icon         String?
  position     Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  group        String?
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  entries      FinancialEntry[]

  @@index([restaurantId, type])
}

model FinancialEntry {
  id             String            @id @default(cuid())
  restaurantId   String
  categoryId     String
  amount         Int
  type           FinancialType
  date           DateTime
  description    String?
  source         EntrySource       @default(MANUAL)
  bankMovementId String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  bankMovement   BankMovement?     @relation(fields: [bankMovementId], references: [id])
  category       FinancialCategory @relation(fields: [categoryId], references: [id])
  restaurant     Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
  @@index([restaurantId, categoryId])
  @@index([bankMovementId])
}

model BankMovement {
  id             String           @id @default(cuid())
  restaurantId   String
  date           DateTime
  description    String
  balance        Int?
  source         String           @default("BCI_XLSX")
  createdAt      DateTime         @default(now())
  agentId        String?
  credit         Int?
  debit          Int?
  externalKey    String?
  status         MovementStatus   @default(PENDING)
  suggestedCatId String?
  agent          CashAgent?       @relation(fields: [agentId], references: [id])
  restaurant     Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  entries        FinancialEntry[]

  @@unique([restaurantId, externalKey])
  @@index([restaurantId, date])
  @@index([restaurantId, status])
}

model CashAgent {
  id           String         @id @default(cuid())
  restaurantId String
  name         String
  bankPatterns String[]
  flujoToken   String?        @unique
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  movements    BankMovement[]
  restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model CategorizationRule {
  id           String                    @id @default(cuid())
  restaurantId String
  pattern      String
  isSplit      Boolean                   @default(false)
  categoryId   String?
  usageCount   Int                       @default(1)
  confidence   Float                     @default(1.0)
  createdAt    DateTime                  @default(now())
  lastUsedAt   DateTime                  @default(now())
  restaurant   Restaurant                @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  splits       CategorizationRuleSplit[]

  @@unique([restaurantId, pattern])
  @@index([restaurantId])
}

model CategorizationRuleSplit {
  id         String             @id @default(cuid())
  ruleId     String
  categoryId String
  ratio      Float
  label      String?
  rule       CategorizationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

/// Ajustes globales de plataforma (key-value). Solo superadmin.
/// Ej: google_api_key (usada por /api/geo/* para "Dirección" en el panel).
model PlatformSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @default(now()) @updatedAt
}

model EcommerceSurveyResponse {
  id           String     @id @default(cuid())
  restaurantId String
  orderId      String?    @unique
  customerName String?
  ratings      Json       @default("{}")
  comment      String?
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

model AbEvent {
  id        String   @id
  variant   String
  eventType String
  sessionId String?
  createdAt DateTime @default(now())

  @@index([variant, eventType, createdAt])
}

